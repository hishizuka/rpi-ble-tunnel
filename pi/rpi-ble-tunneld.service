[Unit]
Description=rpi-ble-tunnel BLE SSH and transparent TCP networking
Requires=bluetooth.service
Wants=NetworkManager.service
After=bluetooth.service ssh.service NetworkManager.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=exec
ExecStart=/usr/local/libexec/rpi-ble-tunnel-network service --adapter hci0 --mode internet
ExecStopPost=/usr/local/libexec/rpi-ble-tunnel-network cleanup
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=45
User=root
RuntimeDirectory=rpi-ble-tunnel rpi-ble-tunnel-network
RuntimeDirectoryMode=0755
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_BLUETOOTH AF_INET AF_INET6 AF_NETLINK
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=80M

[Install]
WantedBy=multi-user.target
