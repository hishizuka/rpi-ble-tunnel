<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_page" android:layout_width="match_parent" android:layout_height="match_parent"
    android:visibility="gone" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/connection_mode" android:textAppearance="@style/PiLink.Body" />
        <TextView android:id="@+id/mode_value" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/mode_unknown" android:textAppearance="@style/PiLink.Title"
            android:clickable="false" android:focusable="false" android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/mode_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/mode_unknown_help" android:textAppearance="@style/PiLink.Body" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/mode_read_only_help" android:textAppearance="@style/PiLink.Body" />
        <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginVertical="28dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/registered_devices" android:textAppearance="@style/PiLink.Title" />
        <LinearLayout android:id="@+id/settings_devices" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" />
        <com.google.android.material.button.MaterialButton android:id="@+id/add_device"
            style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/add_device" android:layout_marginTop="12dp" />
        <TextView android:id="@+id/version" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="32dp" android:textAppearance="@style/PiLink.Body" />
        <com.google.android.material.button.MaterialButton android:id="@+id/licenses"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/open_source_licenses" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
