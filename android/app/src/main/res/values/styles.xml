<resources>
    <style name="AppTheme" parent="Theme.Material3Expressive.Dark.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="colorPrimary">@color/rpi_ble_tunnel_primary</item>
        <item name="colorOnPrimary">@color/rpi_ble_tunnel_on_primary</item>
        <item name="colorPrimaryContainer">@color/rpi_ble_tunnel_selected</item>
        <item name="colorOnPrimaryContainer">@color/rpi_ble_tunnel_primary</item>
        <item name="colorSecondary">@color/rpi_ble_tunnel_primary</item>
        <item name="colorOnSecondary">@color/rpi_ble_tunnel_on_primary</item>
        <item name="colorSecondaryContainer">@color/rpi_ble_tunnel_selected</item>
        <item name="colorOnSecondaryContainer">@color/rpi_ble_tunnel_on_surface</item>
        <item name="colorSurface">@color/rpi_ble_tunnel_background</item>
        <item name="colorSurfaceContainer">@color/rpi_ble_tunnel_surface</item>
        <item name="colorSurfaceContainerHigh">@color/rpi_ble_tunnel_selected</item>
        <item name="colorOnSurface">@color/rpi_ble_tunnel_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/rpi_ble_tunnel_muted</item>
        <item name="colorOutline">@color/rpi_ble_tunnel_outline</item>
        <item name="android:colorBackground">@color/rpi_ble_tunnel_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="RpiBleTunnel.Brand" parent="RpiBleTunnel.Title">
        <item name="android:textSize">26sp</item>
    </style>
    <style name="RpiBleTunnel.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/rpi_ble_tunnel_on_surface</item>
    </style>
    <style name="RpiBleTunnel.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/rpi_ble_tunnel_muted</item>
    </style>
</resources>
